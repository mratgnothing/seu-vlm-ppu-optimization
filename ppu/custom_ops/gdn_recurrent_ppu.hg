#include <hggc_bf16.h>
#include <hggc_runtime.h>

#include <cstddef>
#include <cstdint>
#include <type_traits>

namespace {

constexpr int kHeads = 16;
constexpr int kKeyDim = 128;
constexpr int kValueDim = 128;
constexpr int kConvChannels = 6144;
constexpr int kConvWidth = 4;
constexpr int kHiddenSize = 2048;
constexpr int kGatedNormWidth = 128;
constexpr int kThreads = 128;
constexpr int kWarpSize = 32;
constexpr unsigned kFullWarpMask = 0xffffffffU;
constexpr float kNormEpsilon = 1.0e-6F;

__device__ float warp_sum(float value) {
  for (int offset = kWarpSize / 2; offset > 0; offset >>= 1) {
    value += __shfl_down_sync(kFullWarpMask, value, offset);
  }
  return value;
}

__device__ float round_to_bf16(float value) {
  return __bfloat162float(__float2bfloat16_rn(value));
}

__device__ float block_sum(float value) {
  __shared__ float warp_sums[32];
  const int lane = threadIdx.x & (kWarpSize - 1);
  const int warp = threadIdx.x / kWarpSize;
  const int warp_count = blockDim.x / kWarpSize;
  value = warp_sum(value);
  if (lane == 0) warp_sums[warp] = value;
  __syncthreads();
  if (warp == 0) {
    value = lane < warp_count ? warp_sums[lane] : 0.0F;
    value = warp_sum(value);
  }
  return value;
}

template <int kTilesPerHead>
__global__ void gdn_recurrent_decode_kernel(
    const __ppu_bfloat16* query,
    const __ppu_bfloat16* key,
    const __ppu_bfloat16* value,
    const float* g,
    const __ppu_bfloat16* beta,
    float* state,
    __ppu_bfloat16* output,
    int batch_size,
    int64_t query_batch_stride,
    int64_t key_batch_stride,
    int64_t value_batch_stride,
    int64_t g_batch_stride,
    int64_t beta_batch_stride) {
  const int batch_head = blockIdx.x / kTilesPerHead;
  const int tile = blockIdx.x % kTilesPerHead;
  const int batch = batch_head / kHeads;
  const int head = batch_head % kHeads;
  const int thread = threadIdx.x;
  if (batch >= batch_size) return;

  __shared__ float normalized_query[kKeyDim];
  __shared__ float normalized_key[kKeyDim];
  __shared__ float query_inv_norm;
  __shared__ float key_inv_norm;

  const int64_t query_offset =
      static_cast<int64_t>(batch) * query_batch_stride + head * kKeyDim;
  const int64_t key_offset =
      static_cast<int64_t>(batch) * key_batch_stride + head * kKeyDim;
  const int64_t value_offset =
      static_cast<int64_t>(batch) * value_batch_stride + head * kValueDim;

  float query_square_partial = 0.0F;
  float key_square_partial = 0.0F;
  for (int index = thread; index < kKeyDim; index += blockDim.x) {
    const float query_value = __bfloat162float(query[query_offset + index]);
    const float key_value = __bfloat162float(key[key_offset + index]);
    query_square_partial += round_to_bf16(query_value * query_value);
    key_square_partial += round_to_bf16(key_value * key_value);
  }
  const float query_square_sum = block_sum(query_square_partial);
  if (thread == 0) {
    const float bf16_sum = round_to_bf16(query_square_sum);
    query_inv_norm = round_to_bf16(
        rsqrtf(round_to_bf16(bf16_sum + kNormEpsilon)));
  }
  __syncthreads();
  const float key_square_sum = block_sum(key_square_partial);
  if (thread == 0) {
    const float bf16_sum = round_to_bf16(key_square_sum);
    key_inv_norm = round_to_bf16(
        rsqrtf(round_to_bf16(bf16_sum + kNormEpsilon)));
  }
  __syncthreads();
  for (int index = thread; index < kKeyDim; index += blockDim.x) {
    const float query_value = __bfloat162float(query[query_offset + index]);
    const float key_value = __bfloat162float(key[key_offset + index]);
    normalized_query[index] =
        round_to_bf16(query_value * query_inv_norm) /
        sqrtf(static_cast<float>(kKeyDim));
    normalized_key[index] = round_to_bf16(key_value * key_inv_norm);
  }
  __syncthreads();

  constexpr int kValuesPerTile = kValueDim / kTilesPerHead;
  static_assert(kThreads % kTilesPerHead == 0);
  if (thread >= kValuesPerTile) return;

  const float decay = expf(g[static_cast<int64_t>(batch) * g_batch_stride + head]);
  const float beta_value = __bfloat162float(
      beta[static_cast<int64_t>(batch) * beta_batch_stride + head]);
  const size_t state_head_offset =
      static_cast<size_t>(batch_head) * kKeyDim * kValueDim;
  const int value_index = tile * kValuesPerTile + thread;

  float memory_projection = 0.0F;
  for (int key_index = 0; key_index < kKeyDim; ++key_index) {
    const size_t state_offset = state_head_offset +
        static_cast<size_t>(key_index) * kValueDim + value_index;
    memory_projection +=
        (state[state_offset] * decay) * normalized_key[key_index];
  }
  const float delta =
      (__bfloat162float(value[value_offset + value_index]) -
       memory_projection) * beta_value;

  float result = 0.0F;
  for (int key_index = 0; key_index < kKeyDim; ++key_index) {
    const size_t state_offset = state_head_offset +
        static_cast<size_t>(key_index) * kValueDim + value_index;
    const float updated = state[state_offset] * decay +
                          normalized_key[key_index] * delta;
    state[state_offset] = updated;
    result += updated * normalized_query[key_index];
  }
  output[static_cast<size_t>(batch_head) * kValueDim + value_index] =
      __float2bfloat16_rn(result);
}

__global__ void causal_conv1d_decode_kernel(
    const __ppu_bfloat16* hidden_states,
    __ppu_bfloat16* conv_state,
    const __ppu_bfloat16* weight,
    const __ppu_bfloat16* bias,
    __ppu_bfloat16* output,
    int batch_size,
    int64_t hidden_batch_stride,
    int64_t state_batch_stride,
    bool has_bias) {
  const int channel = blockIdx.x * blockDim.x + threadIdx.x;
  const int batch = blockIdx.y;
  if (batch >= batch_size || channel >= kConvChannels) return;

  const int64_t state_offset =
      static_cast<int64_t>(batch) * state_batch_stride + channel * kConvWidth;
  const int64_t hidden_offset =
      static_cast<int64_t>(batch) * hidden_batch_stride + channel;
  const int64_t weight_offset = channel * kConvWidth;
  const float current = __bfloat162float(hidden_states[hidden_offset]);
  const float state_1 = __bfloat162float(conv_state[state_offset + 1]);
  const float state_2 = __bfloat162float(conv_state[state_offset + 2]);
  const float state_3 = __bfloat162float(conv_state[state_offset + 3]);

  float convolution = has_bias ? __bfloat162float(bias[channel]) : 0.0F;
  convolution += state_1 * __bfloat162float(weight[weight_offset]);
  convolution += state_2 * __bfloat162float(weight[weight_offset + 1]);
  convolution += state_3 * __bfloat162float(weight[weight_offset + 2]);
  convolution += current * __bfloat162float(weight[weight_offset + 3]);
  const float bf16_convolution = round_to_bf16(convolution);
  const float activated =
      bf16_convolution / (1.0F + expf(-bf16_convolution));

  conv_state[state_offset] = conv_state[state_offset + 1];
  conv_state[state_offset + 1] = conv_state[state_offset + 2];
  conv_state[state_offset + 2] = conv_state[state_offset + 3];
  conv_state[state_offset + 3] = __float2bfloat16_rn(current);
  output[static_cast<int64_t>(batch) * kConvChannels + channel] =
      __float2bfloat16_rn(activated);
}

__global__ void rmsnorm_decode_kernel(
    const __ppu_bfloat16* input,
    const __ppu_bfloat16* weight,
    __ppu_bfloat16* output,
    int rows,
    int64_t row_stride,
    float epsilon) {
  const int row = blockIdx.x;
  const int thread = threadIdx.x;
  if (row >= rows) return;
  const int64_t row_offset = static_cast<int64_t>(row) * row_stride;
  float square_sum = 0.0F;
  for (int index = thread; index < kHiddenSize; index += blockDim.x) {
    const float value = __bfloat162float(input[row_offset + index]);
    square_sum += value * value;
  }
  square_sum = block_sum(square_sum);
  __shared__ float inv_rms;
  if (thread == 0) {
    inv_rms = rsqrtf(square_sum / static_cast<float>(kHiddenSize) + epsilon);
  }
  __syncthreads();
  for (int index = thread; index < kHiddenSize; index += blockDim.x) {
    const float value = __bfloat162float(input[row_offset + index]);
    const float scale = 1.0F + __bfloat162float(weight[index]);
    output[static_cast<int64_t>(row) * kHiddenSize + index] =
        __float2bfloat16_rn(value * inv_rms * scale);
  }
}

__global__ void gated_rmsnorm_decode_kernel(
    const __ppu_bfloat16* hidden_states,
    const __ppu_bfloat16* gate,
    const __ppu_bfloat16* weight,
    __ppu_bfloat16* output,
    int rows,
    int64_t hidden_row_stride,
    int64_t gate_row_stride,
    float epsilon) {
  const int row = blockIdx.x;
  const int thread = threadIdx.x;
  if (row >= rows) return;
  const int64_t hidden_offset =
      static_cast<int64_t>(row) * hidden_row_stride;
  const int64_t gate_offset = static_cast<int64_t>(row) * gate_row_stride;
  float square_sum = 0.0F;
  for (int index = thread; index < kGatedNormWidth; index += blockDim.x) {
    const float value = __bfloat162float(hidden_states[hidden_offset + index]);
    square_sum += value * value;
  }
  square_sum = block_sum(square_sum);
  __shared__ float inv_rms;
  if (thread == 0) {
    inv_rms = rsqrtf(
        square_sum / static_cast<float>(kGatedNormWidth) + epsilon);
  }
  __syncthreads();
  for (int index = thread; index < kGatedNormWidth; index += blockDim.x) {
    const float value = __bfloat162float(hidden_states[hidden_offset + index]);
    const float normalized_bf16 = round_to_bf16(value * inv_rms);
    const float weighted_bf16 = round_to_bf16(
        __bfloat162float(weight[index]) * normalized_bf16);
    const float gate_value = __bfloat162float(gate[gate_offset + index]);
    const float silu_gate = gate_value / (1.0F + expf(-gate_value));
    output[static_cast<int64_t>(row) * kGatedNormWidth + index] =
        __float2bfloat16_rn(weighted_bf16 * silu_gate);
  }
}

}  // namespace

extern "C" int seu_ppu_gdn_recurrent_decode_bf16(
    const uint16_t* query,
    const uint16_t* key,
    const uint16_t* value,
    const float* g,
    const uint16_t* beta,
    float* state,
    uint16_t* output,
    int batch_size,
    int64_t query_batch_stride,
    int64_t key_batch_stride,
    int64_t value_batch_stride,
    int64_t g_batch_stride,
    int64_t beta_batch_stride,
    int tiles_per_head,
    void* stream_handle) {
  if (batch_size <= 0) return static_cast<int>(hggcErrorInvalidValue);
  const hggcStream_t stream = reinterpret_cast<hggcStream_t>(stream_handle);
  const auto launch = [&](auto tile_tag) {
    constexpr int kTiles = decltype(tile_tag)::value;
    gdn_recurrent_decode_kernel<kTiles>
        <<<batch_size * kHeads * kTiles, kThreads, 0, stream>>>(
            reinterpret_cast<const __ppu_bfloat16*>(query),
            reinterpret_cast<const __ppu_bfloat16*>(key),
            reinterpret_cast<const __ppu_bfloat16*>(value),
            g,
            reinterpret_cast<const __ppu_bfloat16*>(beta),
            state,
            reinterpret_cast<__ppu_bfloat16*>(output),
            batch_size,
            query_batch_stride,
            key_batch_stride,
            value_batch_stride,
            g_batch_stride,
            beta_batch_stride);
  };
  if (tiles_per_head == 1) {
    launch(std::integral_constant<int, 1>{});
  } else if (tiles_per_head == 2) {
    launch(std::integral_constant<int, 2>{});
  } else if (tiles_per_head == 4) {
    launch(std::integral_constant<int, 4>{});
  } else {
    return static_cast<int>(hggcErrorInvalidValue);
  }
  return static_cast<int>(hggcGetLastError());
}

extern "C" int seu_ppu_causal_conv1d_decode_bf16(
    const uint16_t* hidden_states,
    uint16_t* conv_state,
    const uint16_t* weight,
    const uint16_t* bias,
    uint16_t* output,
    int batch_size,
    int64_t hidden_batch_stride,
    int64_t state_batch_stride,
    int threads,
    void* stream_handle) {
  if (batch_size <= 0 || threads <= 0 || threads > 1024 || threads % 32 != 0) {
    return static_cast<int>(hggcErrorInvalidValue);
  }
  const hggcStream_t stream = reinterpret_cast<hggcStream_t>(stream_handle);
  const dim3 grid((kConvChannels + threads - 1) / threads, batch_size);
  causal_conv1d_decode_kernel<<<grid, threads, 0, stream>>>(
      reinterpret_cast<const __ppu_bfloat16*>(hidden_states),
      reinterpret_cast<__ppu_bfloat16*>(conv_state),
      reinterpret_cast<const __ppu_bfloat16*>(weight),
      reinterpret_cast<const __ppu_bfloat16*>(bias),
      reinterpret_cast<__ppu_bfloat16*>(output),
      batch_size,
      hidden_batch_stride,
      state_batch_stride,
      bias != nullptr);
  return static_cast<int>(hggcGetLastError());
}

extern "C" int seu_ppu_rmsnorm_decode_bf16(
    const uint16_t* input,
    const uint16_t* weight,
    uint16_t* output,
    int rows,
    int64_t row_stride,
    float epsilon,
    int threads,
    void* stream_handle) {
  if (rows <= 0 || threads <= 0 || threads > 1024 || threads % 32 != 0) {
    return static_cast<int>(hggcErrorInvalidValue);
  }
  const hggcStream_t stream = reinterpret_cast<hggcStream_t>(stream_handle);
  rmsnorm_decode_kernel<<<rows, threads, 0, stream>>>(
      reinterpret_cast<const __ppu_bfloat16*>(input),
      reinterpret_cast<const __ppu_bfloat16*>(weight),
      reinterpret_cast<__ppu_bfloat16*>(output),
      rows,
      row_stride,
      epsilon);
  return static_cast<int>(hggcGetLastError());
}

extern "C" int seu_ppu_gated_rmsnorm_decode_bf16(
    const uint16_t* hidden_states,
    const uint16_t* gate,
    const uint16_t* weight,
    uint16_t* output,
    int rows,
    int64_t hidden_row_stride,
    int64_t gate_row_stride,
    float epsilon,
    int threads,
    void* stream_handle) {
  if (rows <= 0 || threads <= 0 || threads > 1024 || threads % 32 != 0) {
    return static_cast<int>(hggcErrorInvalidValue);
  }
  const hggcStream_t stream = reinterpret_cast<hggcStream_t>(stream_handle);
  gated_rmsnorm_decode_kernel<<<rows, threads, 0, stream>>>(
      reinterpret_cast<const __ppu_bfloat16*>(hidden_states),
      reinterpret_cast<const __ppu_bfloat16*>(gate),
      reinterpret_cast<const __ppu_bfloat16*>(weight),
      reinterpret_cast<__ppu_bfloat16*>(output),
      rows,
      hidden_row_stride,
      gate_row_stride,
      epsilon);
  return static_cast<int>(hggcGetLastError());
}
